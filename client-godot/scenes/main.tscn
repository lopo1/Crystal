[gd_scene load_steps=2 format=3 uid="uid://crystal_main"]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

; -----------------------------------------------------------------------------
; 背景: 使用 pfffft.png (Mir2 启动背景) + 半透明覆盖
; -----------------------------------------------------------------------------
[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
expand_mode = 1
stretch_mode = 6

[node name="BackgroundTint" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.5)
mouse_filter = 2

; -----------------------------------------------------------------------------
; 登录面板
; -----------------------------------------------------------------------------
[node name="LoginPanel" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -260.0
offset_top = -220.0
offset_right = 260.0
offset_bottom = 240.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="LoginPanel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="LoginPanel/VBox"]
layout_mode = 2
text = "Crystal - 登录服务器"
horizontal_alignment = 1
font_size = 16

[node name="HSep" type="HSeparator" parent="LoginPanel/VBox"]
layout_mode = 2

[node name="ServerRow" type="HBoxContainer" parent="LoginPanel/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="ServerLabel" type="Label" parent="LoginPanel/VBox/ServerRow"]
